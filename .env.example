# ============================================================
#  base-spring-api - Variables de entorno (EJEMPLO)
#  Copiar este archivo como .env y completar los valores
#  cp .env.example .env
# ============================================================

# IP_SERVER= (vacío=local | IP=dockerizado, ej: 192.168.12.42)
IP_SERVER=

SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

DB_ENGINE=postgres

# --- PostgreSQL ---------------------------------------------- [VAULT]
DB_POSTGRES_HOST=
DB_POSTGRES_PORT=
DB_POSTGRES_NAME=
DB_POSTGRES_SCHEMA=
DB_POSTGRES_USERNAME=
DB_POSTGRES_PASSWORD=
DB_POSTGRES_DDL_AUTO=update
DB_POSTGRES_SHOW_SQL=false

# --- Oracle -------------------------------------------------- [VAULT]
DB_ORACLE_HOST=
DB_ORACLE_PORT=
DB_ORACLE_SERVICE=
DB_ORACLE_USERNAME=
DB_ORACLE_PASSWORD=
DB_ORACLE_DDL_AUTO=none
DB_ORACLE_SHOW_SQL=false

# --- MongoDB ------------------------------------------------- [VAULT]
MONGO_ENABLED=false
DB_MONGO_HOST=
DB_MONGO_PORT=
DB_MONGO_NAME=
DB_MONGO_USERNAME=
DB_MONGO_PASSWORD=
DB_MONGO_AUTH_DB=

# --- Vault ---------------------------------------------------
VAULT_ENABLED=false
VAULT_INIT_ENABLED=true
VAULT_HOST=svc-vault
VAULT_PORT=8200
VAULT_SCHEME=http
VAULT_USERNAME=
VAULT_PASSWORD=
VAULT_APP_NAME=base-spring-api

# --- Almacenamiento local ------------------------------------
STORAGE_LOCAL_PATH=uploads

# --- MinIO --------------------------------------------------- [VAULT]
MINIO_ENABLED=false
MINIO_URL=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_DEFAULT=base-spring-bucket

# --- RSA (cifrado de campos sensibles: cedula, correo) -------- [VAULT]
RSA_ENABLED=false
RSA_PUBLIC_KEY=
RSA_PRIVATE_KEY=

# --- Actuator ------------------------------------------------
ACTUATOR_EXPOSURE=health,info,metrics,env

# --- Swagger -------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_TITLE=base-spring-api
SWAGGER_DESCRIPTION=API REST base con Spring Boot 3
SWAGGER_VERSION=0.0.1
